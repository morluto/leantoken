---
source: src/mcp.rs
expression: tools
---
[
  {
    "name": "context",
    "description": "DEFAULT FIRST CALL for broad coding, debugging, review, and architecture tasks. Returns the most relevant repository evidence within a strict token budget instead of manually combining search and whole-file reads. For uncertain broad tasks, set plan_only=true to preview bounded ranked paths, ranges, reasons, token estimates, focus coverage, and generated-artifact warnings without source or receipt mutation; then repeat the same request with plan_only=false to materialize. Use include_paths, strict_focus_paths, or strict_changed_paths for hard boundaries; pass BASE..HEAD as base_revision for an immutable Git range. Use minimum_fragments_per_focus_path and must-include constraints for required paths or symbols. When path presence is insufficient, pass required_evidence entries with a path and literal queries; path_scope_satisfied reports only path coverage, while evidence_scope_satisfied requires matching selected evidence. When the caller has directly observed a failure, pass workflow_evidence with bounded failure_traces, symbols, paths, or test_intents; do not infer or copy gold labels into it. Compact omission counts preserve fail-loud coverage by default; set verbose_diagnostics=true only for full omission facets. Oversized diff scopes may return bounded routing suggestions. Reuse receipt fragment_hashes as known_hashes. Set handoff for a compact provenance manifest without copied source. Example: {\"task\":\"Audit MCP tool discovery\"}.",
    "inputSchema": {
      "$defs": {
        "ContextRequiredEvidence": {
          "additionalProperties": false,
          "description": "One path-scoped evidence requirement for `leantoken.context`.",
          "properties": {
            "minimum_query_matches": {
              "default": 1,
              "description": "Minimum number of distinct queries that selected evidence must match.",
              "format": "uint",
              "maximum": 16,
              "minimum": 1,
              "type": "integer"
            },
            "path": {
              "description": "Repository-relative path pattern whose evidence must be represented.",
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "queries": {
              "description": "Alternative literal queries; distinct matches contribute to the minimum.",
              "items": {
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 16,
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "path",
            "queries"
          ],
          "type": "object"
        },
        "ContextWorkflow": {
          "description": "Requested or resolved evidence workflow for context retrieval.",
          "oneOf": [
            {
              "const": "auto",
              "description": "Infer a workflow only from high-confidence task language.",
              "type": "string"
            },
            {
              "const": "implementation",
              "description": "General feature, fix, and refactor implementation evidence.",
              "type": "string"
            },
            {
              "const": "contribution",
              "description": "Repository guidance, templates, validation, changed files, and owner tests.",
              "type": "string"
            },
            {
              "const": "review",
              "description": "Changed code, repository guidance, validation, and review evidence.",
              "type": "string"
            },
            {
              "const": "investigation",
              "description": "Diagnostic evidence for tracing behavior and root causes.",
              "type": "string"
            }
          ]
        },
        "HandoffManifestRequest": {
          "additionalProperties": false,
          "description": "Optional host-supplied state carried into a compact context handoff manifest.",
          "properties": {
            "assumptions": {
              "default": [],
              "description": "Assumptions the next executor must preserve or verify.",
              "items": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 16,
              "type": "array"
            },
            "avoid_rules": {
              "default": [],
              "description": "Explicit constraints describing approaches or paths to avoid.",
              "items": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 16,
              "type": "array"
            },
            "negative_evidence": {
              "default": [],
              "description": "Searches or checks that produced no supporting evidence.",
              "items": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 16,
              "type": "array"
            },
            "open_questions": {
              "default": [],
              "description": "Questions that remain unresolved at handoff time.",
              "items": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 16,
              "type": "array"
            },
            "summary": {
              "default": null,
              "description": "Compact task summary; the context task is used when omitted.",
              "maxLength": 512,
              "minLength": 1,
              "type": [
                "string",
                "null"
              ]
            },
            "validations": {
              "default": [],
              "description": "Commands and checks reported by the caller.",
              "items": {
                "$ref": "#/$defs/HandoffValidation"
              },
              "maxItems": 16,
              "type": "array"
            }
          },
          "type": "object"
        },
        "HandoffValidation": {
          "additionalProperties": false,
          "description": "Caller-reported validation retained in a handoff manifest.",
          "properties": {
            "command": {
              "description": "Exact command or check identifier.",
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/HandoffValidationStatus",
              "description": "Caller-reported outcome; LeanToken does not execute this command."
            },
            "summary": {
              "description": "Optional compact result detail.",
              "maxLength": 512,
              "minLength": 1,
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "command",
            "status"
          ],
          "type": "object"
        },
        "HandoffValidationStatus": {
          "description": "Caller-reported outcome of one handoff validation.",
          "oneOf": [
            {
              "const": "passed",
              "description": "The caller reports that the check passed.",
              "type": "string"
            },
            {
              "const": "failed",
              "description": "The caller reports that the check failed.",
              "type": "string"
            }
          ]
        },
        "WorkflowEvidence": {
          "additionalProperties": false,
          "description": "Caller-observed workflow signals kept separate from the natural-language task.\n\nUse the builder methods instead of constructing this non-exhaustive type\ndirectly. Values are validated by [`crate::services::Services`] before retrieval.",
          "properties": {
            "failure_traces": {
              "default": [],
              "description": "Bounded compiler, test, runtime, or log excerpts.",
              "items": {
                "maxLength": 8192,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 8,
              "type": "array"
            },
            "paths": {
              "default": [],
              "description": "Normalized repository-relative paths observed by the caller.",
              "items": {
                "maxLength": 8192,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 8,
              "type": "array"
            },
            "symbols": {
              "default": [],
              "description": "Exact or qualified identifiers observed by the caller.",
              "items": {
                "maxLength": 8192,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 8,
              "type": "array"
            },
            "test_intents": {
              "default": [],
              "description": "Test names, commands, or behavioral checks relevant to the task.",
              "items": {
                "maxLength": 8192,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 8,
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "base_revision": {
          "default": null,
          "description": "Base revision or `BASE..HEAD` range for diff-scoped context.",
          "maxLength": 256,
          "type": [
            "string",
            "null"
          ]
        },
        "changed_paths": {
          "default": [],
          "description": "Changed paths for diff-scoped context.",
          "items": {
            "maxLength": 4096,
            "type": "string"
          },
          "maxItems": 512,
          "type": "array"
        },
        "consistency": {
          "default": "indexed_generation",
          "description": "Use `reconcile_working_tree` after edits; otherwise `indexed_generation`.",
          "enum": [
            "indexed_generation",
            "reconcile_working_tree"
          ],
          "type": "string"
        },
        "exclude_paths": {
          "default": [],
          "description": "Exclude matching repository paths.",
          "items": {
            "maxLength": 4096,
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "expected_repository_id": {
          "default": null,
          "description": "Expected opaque repository identity from an earlier response.",
          "maxLength": 128,
          "type": [
            "string",
            "null"
          ]
        },
        "focus_paths": {
          "default": [],
          "description": "Boost matching paths without filtering other candidates.",
          "items": {
            "maxLength": 4096,
            "type": "string"
          },
          "maxItems": 32,
          "type": "array"
        },
        "focus_symbols": {
          "default": [],
          "description": "Boost candidates for these exact symbol names.",
          "items": {
            "maxLength": 4096,
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "handoff": {
          "anyOf": [
            {
              "$ref": "#/$defs/HandoffManifestRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Attach a compact provenance manifest for a host-triggered executor handoff."
        },
        "include_paths": {
          "default": [],
          "description": "Require every returned source fragment to match one of these path patterns.",
          "items": {
            "maxLength": 4096,
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "known_hashes": {
          "default": [],
          "description": "Fragment hashes already held by the caller and not to resend.",
          "items": {
            "maxLength": 128,
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "max_fragments": {
          "default": 8,
          "description": "Maximum returned fragments (default 8, maximum 100).",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "max_response_tokens": {
          "default": null,
          "description": "Maximum tokens in the final serialized service response.",
          "format": "uint",
          "maximum": 32000,
          "minimum": 1,
          "type": "integer"
        },
        "minimum_fragments_per_focus_path": {
          "default": null,
          "description": "Minimum returned fragments required per focus path (maximum 8).",
          "maximum": 8,
          "minimum": 1,
          "type": "integer"
        },
        "must_include_paths": {
          "default": [],
          "description": "Require evidence matching every indexed path pattern.",
          "items": {
            "maxLength": 4096,
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "must_include_symbols": {
          "default": [],
          "description": "Require evidence for every exact indexed symbol.",
          "items": {
            "maxLength": 4096,
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "plan_only": {
          "default": false,
          "description": "Preview ranked candidates without source or receipt mutation; omit `receipt_id`.",
          "type": "boolean"
        },
        "prior_repository_generation": {
          "default": null,
          "description": "Earlier generation used to boost files indexed since that response.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "receipt_id": {
          "default": null,
          "description": "Suppress evidence already returned under this server-managed receipt.",
          "maxLength": 128,
          "type": [
            "string",
            "null"
          ]
        },
        "required_evidence": {
          "default": [],
          "description": "Require matching query evidence within each path-scoped contract.",
          "items": {
            "$ref": "#/$defs/ContextRequiredEvidence"
          },
          "maxItems": 32,
          "type": "array"
        },
        "strict_changed_paths": {
          "default": false,
          "description": "Require every returned fragment to belong to the resolved changed paths.",
          "type": "boolean"
        },
        "strict_focus_paths": {
          "default": false,
          "description": "Require every returned fragment to match at least one focus path.",
          "type": "boolean"
        },
        "task": {
          "description": "Natural-language coding task; include known identifiers and constraints.",
          "maxLength": 65536,
          "minLength": 3,
          "type": "string"
        },
        "token_budget": {
          "default": 3000,
          "description": "Maximum source tokens across selected fragments (default 3000, maximum 32000).",
          "format": "uint",
          "maximum": 32000,
          "minimum": 1,
          "type": "integer"
        },
        "verbose_diagnostics": {
          "default": false,
          "description": "Include full path, file-type, reason, score-band, focus, and change omission facets.",
          "type": "boolean"
        },
        "workflow": {
          "$ref": "#/$defs/ContextWorkflow",
          "default": "auto",
          "description": "Evidence workflow; `auto` selects only on high-confidence task language."
        },
        "workflow_evidence": {
          "$ref": "#/$defs/WorkflowEvidence",
          "default": {
            "failure_traces": [],
            "paths": [],
            "symbols": [],
            "test_intents": []
          },
          "description": "Typed caller-observed failure traces, symbols, paths, and test intent."
        }
      },
      "required": [
        "task"
      ],
      "type": "object"
    }
  },
  {
    "name": "files",
    "description": "Preferred repository path discovery instead of find, ls, or glob. Use tree for hierarchy, find for fuzzy filenames, and glob for path patterns; returns paths, not source. Set projection=paths for opt-in path-only results without kind, language, size, or score metadata. Example: {\"operation\":\"find\",\"query\":\"mcp\"}.",
    "inputSchema": {
      "$defs": {
        "FileOperation": {
          "description": "Repository path-discovery operation.",
          "oneOf": [
            {
              "const": "tree",
              "description": "Return a compact hierarchy.",
              "type": "string"
            },
            {
              "const": "find",
              "description": "Fuzzy-match paths and basenames.",
              "type": "string"
            },
            {
              "const": "glob",
              "description": "Match indexed paths with a glob.",
              "type": "string"
            }
          ]
        },
        "FilesMcpProjection": {
          "description": "Response projection for repository path discovery.",
          "oneOf": [
            {
              "const": "full",
              "description": "Preserve the complete files response.",
              "type": "string"
            },
            {
              "const": "paths",
              "description": "Return paths without per-entry kind, language, size, or score metadata.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "oneOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "query"
                ]
              },
              {
                "required": [
                  "pattern"
                ]
              }
            ]
          },
          "properties": {
            "operation": {
              "const": "tree"
            }
          }
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "pattern"
                ]
              },
              {
                "required": [
                  "depth"
                ]
              }
            ]
          },
          "properties": {
            "operation": {
              "const": "find"
            },
            "query": {
              "type": "string"
            }
          },
          "required": [
            "query"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "query"
                ]
              },
              {
                "required": [
                  "depth"
                ]
              }
            ]
          },
          "properties": {
            "operation": {
              "const": "glob"
            },
            "pattern": {
              "type": "string"
            }
          },
          "required": [
            "pattern"
          ]
        }
      ],
      "properties": {
        "consistency": {
          "default": "indexed_generation",
          "description": "Use `reconcile_working_tree` after edits; otherwise `indexed_generation`.",
          "enum": [
            "indexed_generation",
            "reconcile_working_tree"
          ],
          "type": "string"
        },
        "cursor": {
          "default": null,
          "description": "Cursor returned by the same operation and repository generation.",
          "maxLength": 4096,
          "type": [
            "string",
            "null"
          ]
        },
        "depth": {
          "default": null,
          "description": "Maximum hierarchy depth below `path` for `tree`.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "expected_repository_id": {
          "default": null,
          "description": "Expected opaque repository identity from an earlier response.",
          "maxLength": 128,
          "type": [
            "string",
            "null"
          ]
        },
        "max_response_tokens": {
          "default": null,
          "description": "Maximum tokens in the final serialized service response.",
          "format": "uint",
          "maximum": 32000,
          "minimum": 1,
          "type": "integer"
        },
        "max_results": {
          "default": 20,
          "description": "Maximum entries to return (default 20, maximum 100).",
          "format": "uint",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "operation": {
          "$ref": "#/$defs/FileOperation",
          "description": "Path operation to perform."
        },
        "path": {
          "default": null,
          "description": "Optional repository-relative directory for `tree`.",
          "maxLength": 4096,
          "type": [
            "string",
            "null"
          ]
        },
        "pattern": {
          "default": null,
          "description": "Non-empty glob pattern for `glob`.",
          "maxLength": 4096,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "projection": {
          "$ref": "#/$defs/FilesMcpProjection",
          "default": "full",
          "description": "Response shape: `full` entries (default) or ordered `paths` only."
        },
        "query": {
          "default": null,
          "description": "Non-empty fuzzy filename or path query for `find`.",
          "maxLength": 65536,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "operation"
      ],
      "type": "object"
    }
  },
  {
    "name": "history",
    "description": "Read, diff, batch-diff, or trace parsed symbols across immutable Git revisions. Symbols may use parent.name qualification. diff_symbols resolves one shared range, loads each bounded path once per endpoint, and returns cursor-paged per-symbol outcomes without N Git subprocess chains. diff_symbol returns bounded add/delete diffs when one endpoint is absent; symbol_log traces tracked lines. For immutable range-scoped context, pass BASE..HEAD as context.base_revision with strict_changed_paths. Example: {\"operation\":{\"kind\":\"diff_symbols\",\"targets\":[{\"path\":\"src/services.rs\",\"symbol\":\"Services.meta\"}],\"base_revision\":\"main~1\",\"head_revision\":\"main\"}}.",
    "inputSchema": {
      "$defs": {
        "HistoryMcpOperation": {
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "Read one parsed symbol, optionally qualified as `parent.name`, from an immutable revision.",
              "properties": {
                "kind": {
                  "const": "read_symbol",
                  "type": "string"
                },
                "path": {
                  "maxLength": 4096,
                  "minLength": 1,
                  "type": "string"
                },
                "revision": {
                  "maxLength": 4096,
                  "minLength": 1,
                  "type": "string"
                },
                "symbol": {
                  "maxLength": 4096,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "path",
                "symbol",
                "revision"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Compare one parsed symbol across revisions, including added or removed endpoints.",
              "properties": {
                "base_revision": {
                  "maxLength": 4096,
                  "minLength": 1,
                  "type": "string"
                },
                "head_revision": {
                  "maxLength": 4096,
                  "minLength": 1,
                  "type": "string"
                },
                "kind": {
                  "const": "diff_symbol",
                  "type": "string"
                },
                "path": {
                  "maxLength": 4096,
                  "minLength": 1,
                  "type": "string"
                },
                "symbol": {
                  "maxLength": 4096,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "path",
                "symbol",
                "base_revision",
                "head_revision"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Diff an ordered symbol set with shared revisions, metadata, and bounded Git work.",
              "properties": {
                "base_revision": {
                  "maxLength": 4096,
                  "minLength": 1,
                  "type": "string"
                },
                "head_revision": {
                  "maxLength": 4096,
                  "minLength": 1,
                  "type": "string"
                },
                "kind": {
                  "const": "diff_symbols",
                  "type": "string"
                },
                "targets": {
                  "items": {
                    "$ref": "#/$defs/HistoryMcpTarget"
                  },
                  "maxItems": 64,
                  "minItems": 1,
                  "type": "array"
                }
              },
              "required": [
                "kind",
                "targets",
                "base_revision",
                "head_revision"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "List commits that touched the symbol's tracked historical lines.",
              "properties": {
                "kind": {
                  "const": "symbol_log",
                  "type": "string"
                },
                "path": {
                  "maxLength": 4096,
                  "minLength": 1,
                  "type": "string"
                },
                "revision": {
                  "default": null,
                  "maxLength": 4096,
                  "minLength": 1,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "symbol": {
                  "maxLength": 4096,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "path",
                "symbol"
              ],
              "type": "object"
            }
          ]
        },
        "HistoryMcpTarget": {
          "additionalProperties": false,
          "properties": {
            "head_path": {
              "default": null,
              "maxLength": 4096,
              "minLength": 1,
              "type": [
                "string",
                "null"
              ]
            },
            "head_symbol": {
              "default": null,
              "maxLength": 4096,
              "minLength": 1,
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "symbol": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "path",
            "symbol"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "default": null,
          "description": "Opaque cursor returned by `diff_symbols`; reuse the exact operation.",
          "maxLength": 128,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "expected_repository_id": {
          "default": null,
          "description": "Expected opaque repository identity from an earlier response.",
          "maxLength": 128,
          "type": [
            "string",
            "null"
          ]
        },
        "max_response_tokens": {
          "default": null,
          "description": "Maximum tokens in the final serialized service response.",
          "format": "uint",
          "maximum": 32000,
          "minimum": 1,
          "type": "integer"
        },
        "max_results": {
          "default": 20,
          "description": "Maximum results (default 20): 32 for `diff_symbols`, 100 for `symbol_log`.",
          "format": "uint",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "max_tokens": {
          "default": 8000,
          "description": "Maximum source or diff tokens to return (default 8000, maximum 32000).",
          "format": "uint",
          "maximum": 32000,
          "minimum": 1,
          "type": "integer"
        },
        "operation": {
          "$ref": "#/$defs/HistoryMcpOperation",
          "description": "Git-backed symbol history operation."
        }
      },
      "required": [
        "operation"
      ],
      "type": "object"
    }
  },
  {
    "name": "json",
    "description": "Query, summarize, or compare bounded live JSON without indexing raw artifacts. Select with RFC 6901 JSON Pointer or standard JMESPath; use collapsed, keys, or schema projections for large arrays and objects, numeric_summary for count/min/median/p95/max, and diff_fields for selected values across two files. Keys can be bounded by depth (root is zero) and paginate in depth-then-pointer order; incomplete schemas return a breadth-first shape with explicit omission metadata. Repeat an incomplete keys query with its cursor. Example: {\"operation\":{\"kind\":\"numeric_summary\",\"path\":\"artifacts/results.json\",\"selector\":{\"kind\":\"jmespath\",\"expression\":\"runs[].score\"}}}.",
    "inputSchema": {
      "$defs": {
        "JsonMcpOperation": {
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "Select and project one JSON value.",
              "properties": {
                "kind": {
                  "const": "query",
                  "type": "string"
                },
                "path": {
                  "maxLength": 4096,
                  "minLength": 1,
                  "type": "string"
                },
                "projection": {
                  "$ref": "#/$defs/JsonProjection",
                  "default": "value"
                },
                "selector": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/JsonMcpSelector"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "path"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Summarize numeric leaves below one JSON selection.",
              "properties": {
                "kind": {
                  "const": "numeric_summary",
                  "type": "string"
                },
                "path": {
                  "maxLength": 4096,
                  "minLength": 1,
                  "type": "string"
                },
                "selector": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/JsonMcpSelector"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "path"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Compare selected fields between two JSON files.",
              "properties": {
                "base_path": {
                  "maxLength": 4096,
                  "minLength": 1,
                  "type": "string"
                },
                "head_path": {
                  "maxLength": 4096,
                  "minLength": 1,
                  "type": "string"
                },
                "kind": {
                  "const": "diff_fields",
                  "type": "string"
                },
                "projection": {
                  "$ref": "#/$defs/JsonProjection",
                  "default": "value"
                },
                "selectors": {
                  "items": {
                    "$ref": "#/$defs/JsonMcpSelector"
                  },
                  "maxItems": 100,
                  "minItems": 1,
                  "type": "array"
                }
              },
              "required": [
                "kind",
                "base_path",
                "head_path",
                "selectors"
              ],
              "type": "object"
            }
          ]
        },
        "JsonMcpSelector": {
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "RFC 6901 JSON Pointer.",
              "properties": {
                "kind": {
                  "const": "pointer",
                  "type": "string"
                },
                "pointer": {
                  "maxLength": 4096,
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "pointer"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Standard JMESPath expression.",
              "properties": {
                "expression": {
                  "maxLength": 4096,
                  "minLength": 1,
                  "type": "string"
                },
                "kind": {
                  "const": "jmespath",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "expression"
              ],
              "type": "object"
            }
          ]
        },
        "JsonProjection": {
          "description": "Structural projection applied after JSON selection.",
          "oneOf": [
            {
              "const": "value",
              "description": "Preserve the selected JSON value.",
              "type": "string"
            },
            {
              "const": "collapsed",
              "description": "Replace arrays with count and bounded sample summaries.",
              "type": "string"
            },
            {
              "const": "keys",
              "description": "Return JSON Pointer-shaped key paths and value types only.",
              "type": "string"
            },
            {
              "const": "schema",
              "description": "Return an inferred structural schema without leaf values.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "array_sample_size": {
          "default": null,
          "description": "Array elements sampled by collapsed projections (default 3, maximum 20).",
          "format": "uint",
          "maximum": 20,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cursor": {
          "default": null,
          "description": "Opaque cursor returned by an incomplete keys projection.",
          "maxLength": 256,
          "type": [
            "string",
            "null"
          ]
        },
        "depth": {
          "default": null,
          "description": "Maximum keys traversal depth relative to the selected root (root is zero).",
          "format": "uint",
          "maximum": 64,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "expected_repository_id": {
          "default": null,
          "description": "Expected opaque repository identity from an earlier response.",
          "maxLength": 128,
          "type": [
            "string",
            "null"
          ]
        },
        "max_items": {
          "default": null,
          "description": "Maximum structural items returned (default 1000, maximum 10000).",
          "format": "uint",
          "maximum": 10000,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_response_tokens": {
          "default": null,
          "description": "Maximum tokens in the final serialized service response.",
          "format": "uint",
          "maximum": 32000,
          "minimum": 1,
          "type": "integer"
        },
        "max_tokens": {
          "default": 8000,
          "description": "Maximum tokens across selected/projected JSON (default 8000, maximum 32000).",
          "format": "uint",
          "maximum": 32000,
          "minimum": 1,
          "type": "integer"
        },
        "operation": {
          "$ref": "#/$defs/JsonMcpOperation",
          "description": "Structural JSON operation."
        }
      },
      "required": [
        "operation"
      ],
      "type": "object"
    }
  },
  {
    "name": "outline",
    "description": "Inspect file structure without reading whole source files. Prefer this when the file is known but the relevant symbol or range is not; then use leantoken.read. Set projection=signatures to omit imports and byte offsets while retaining path, line range, signature-set hash, parse coverage, freshness, and continuation. Example: {\"paths\":[\"src/mcp.rs\"]}.",
    "inputSchema": {
      "$defs": {
        "OutlineMcpProjection": {
          "description": "Response projection for structural outlines.",
          "oneOf": [
            {
              "const": "full",
              "description": "Preserve symbols, imports, and byte offsets.",
              "type": "string"
            },
            {
              "const": "signatures",
              "description": "Return symbol signatures and line ranges without imports or byte offsets.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "consistency": {
          "default": "indexed_generation",
          "description": "Use `reconcile_working_tree` after edits; otherwise `indexed_generation`.",
          "enum": [
            "indexed_generation",
            "reconcile_working_tree"
          ],
          "type": "string"
        },
        "cursor": {
          "default": null,
          "description": "Opaque cursor from a result-limited outline response.",
          "maxLength": 256,
          "type": [
            "string",
            "null"
          ]
        },
        "expected_repository_id": {
          "default": null,
          "description": "Expected opaque repository identity from an earlier response.",
          "maxLength": 128,
          "type": [
            "string",
            "null"
          ]
        },
        "max_response_tokens": {
          "default": null,
          "description": "Maximum tokens in the final serialized service response.",
          "format": "uint",
          "maximum": 32000,
          "minimum": 1,
          "type": "integer"
        },
        "max_results": {
          "default": 20,
          "description": "Maximum definitions and imports to return (default 20, maximum 100).",
          "format": "uint",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "max_tokens": {
          "default": 8000,
          "description": "Maximum signature and import tokens (default 8000, maximum 32000).",
          "format": "uint",
          "maximum": 32000,
          "minimum": 1,
          "type": "integer"
        },
        "paths": {
          "description": "One to 256 repository-relative source files to outline.",
          "items": {
            "maxLength": 4096,
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        },
        "projection": {
          "$ref": "#/$defs/OutlineMcpProjection",
          "default": "full",
          "description": "Response shape: `full` definitions (default) or compact `signatures`."
        },
        "receipt_id": {
          "default": null,
          "description": "Suppress evidence already returned under this server-managed receipt.",
          "maxLength": 128,
          "type": [
            "string",
            "null"
          ]
        },
        "symbol_kind": {
          "default": null,
          "description": "Keep definitions of this exact syntax kind.",
          "maxLength": 4096,
          "type": [
            "string",
            "null"
          ]
        },
        "symbol_name": {
          "default": null,
          "description": "Keep definitions whose names contain this value.",
          "maxLength": 4096,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "paths"
      ],
      "type": "object"
    }
  },
  {
    "name": "read",
    "description": "Preferred exact source and Markdown section reader instead of cat, head, or sed. Keep path as a file path; put the owner separately in target. Exact target shapes include {\"kind\":\"symbol\",\"name\":\"LeanTokenMcp\"}, {\"kind\":\"heading\",\"name\":\"## Performance\",\"occurrence\":2}, and {\"kind\":\"lines\",\"start\":120,\"end\":160}. Heading targets accept an exact rendered title or outline signature. Reuse content_hash as expected_hash to suppress unchanged source. Example: {\"path\":\"README.md\",\"target\":{\"kind\":\"heading\",\"name\":\"Installation\"}}.",
    "inputSchema": {
      "$defs": {
        "ReadMcpTarget": {
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "Read one indexed symbol definition.",
              "properties": {
                "kind": {
                  "const": "symbol",
                  "type": "string"
                },
                "name": {
                  "description": "Exact indexed symbol name.",
                  "maxLength": 4096,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "name"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Read one indexed Markdown section by exact heading title or outline signature.",
              "properties": {
                "kind": {
                  "const": "heading",
                  "type": "string"
                },
                "name": {
                  "description": "Exact rendered heading title or outline signature such as `## Performance`.",
                  "maxLength": 4096,
                  "minLength": 1,
                  "type": "string"
                },
                "occurrence": {
                  "default": 1,
                  "description": "One-based occurrence when the heading text is duplicated.",
                  "format": "uint",
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "name"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Read one inclusive one-based line range.",
              "properties": {
                "end": {
                  "description": "Last one-based line; must be at least `start`.",
                  "format": "uint",
                  "minimum": 1,
                  "type": "integer"
                },
                "kind": {
                  "const": "lines",
                  "type": "string"
                },
                "start": {
                  "description": "First one-based line.",
                  "format": "uint",
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "start",
                "end"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Continue a truncated read without losing a partial final line.",
              "properties": {
                "cursor": {
                  "description": "Opaque cursor from the preceding truncated response.",
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                },
                "kind": {
                  "const": "continuation",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "cursor"
              ],
              "type": "object"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "consistency": {
          "default": "indexed_generation",
          "description": "Use `reconcile_working_tree` after edits; otherwise `indexed_generation`.",
          "enum": [
            "indexed_generation",
            "reconcile_working_tree"
          ],
          "type": "string"
        },
        "delta": {
          "default": false,
          "description": "Record this target and prefer a cheaper complete delta on changed follow-ups.",
          "type": "boolean"
        },
        "expected_hash": {
          "default": null,
          "description": "Hash from the same prior target; matching content returns `not_modified`.",
          "maxLength": 128,
          "type": [
            "string",
            "null"
          ]
        },
        "expected_repository_id": {
          "default": null,
          "description": "Expected opaque repository identity from an earlier response.",
          "maxLength": 128,
          "type": [
            "string",
            "null"
          ]
        },
        "max_response_tokens": {
          "default": null,
          "description": "Maximum tokens in the final serialized service response.",
          "format": "uint",
          "maximum": 32000,
          "minimum": 1,
          "type": "integer"
        },
        "max_tokens": {
          "default": 8000,
          "description": "Maximum source tokens to return (default 8000, maximum 32000).",
          "format": "uint",
          "maximum": 32000,
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "description": "Repository-relative UTF-8 source file.",
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "receipt_id": {
          "default": null,
          "description": "Suppress evidence already returned under this server-managed receipt.",
          "maxLength": 128,
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "$ref": "#/$defs/ReadMcpTarget",
          "description": "Exact symbol, Markdown heading, line range, or continuation to read."
        }
      },
      "required": [
        "path",
        "target"
      ],
      "type": "object"
    }
  },
  {
    "name": "savings",
    "description": "Report repository-local observed response accounting, expected-hash suppression, service failures, and explicitly unobserved task outcomes. Source and response deltas are comparisons against represented source, not claims about task success. Example: {}.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "search",
    "description": "Preferred indexed source search instead of grep or rg. Finds ranked symbols, references, identifiers, text, or regex matches. Set projection=grouped for opt-in symbol/file summaries that retain one verifiable excerpt, reference counts, coverage, freshness, and continuation without repeated scores or excerpts. Set all_occurrences in text or regex mode for exact occurrence coordinates and returned/total counts; exhaustive scans fail instead of silently truncating at internal scan limits. Text and regex hits include the narrowest enclosing_symbol when structural data is available; use that exact name or the returned line range with leantoken.read. Example: {\"query\":\"RetryableConflict\",\"mode\":\"symbol\"}.",
    "inputSchema": {
      "$defs": {
        "SearchMcpProjection": {
          "description": "Response projection for indexed search.",
          "oneOf": [
            {
              "const": "full",
              "description": "Preserve the complete ranked-hit response.",
              "type": "string"
            },
            {
              "const": "grouped",
              "description": "Group the selected page into symbol or file summaries.",
              "type": "string"
            }
          ]
        },
        "SearchMode": {
          "description": "Search candidate source.",
          "oneOf": [
            {
              "const": "auto",
              "description": "Combine structural and lexical candidates.",
              "type": "string"
            },
            {
              "const": "text",
              "description": "Match a literal substring.",
              "type": "string"
            },
            {
              "const": "regex",
              "description": "Verify a Rust regular expression over indexed chunks.",
              "type": "string"
            },
            {
              "const": "identifier",
              "description": "Search identifier tokens and structural names.",
              "type": "string"
            },
            {
              "const": "symbol",
              "description": "Search definitions only.",
              "type": "string"
            },
            {
              "const": "reference",
              "description": "Search syntactic references only.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "all_occurrences": {
          "default": false,
          "description": "Return every text or regex occurrence with exact coordinates and counts.",
          "type": "boolean"
        },
        "case_sensitive": {
          "default": false,
          "description": "Preserve query case when matching.",
          "type": "boolean"
        },
        "consistency": {
          "default": "indexed_generation",
          "description": "Use `reconcile_working_tree` after edits; otherwise `indexed_generation`.",
          "enum": [
            "indexed_generation",
            "reconcile_working_tree"
          ],
          "type": "string"
        },
        "context_lines": {
          "default": 2,
          "description": "Lines before and after each match (default 2, maximum 20).",
          "format": "uint",
          "maximum": 20,
          "minimum": 0,
          "type": "integer"
        },
        "cursor": {
          "default": null,
          "description": "Cursor returned by the same search and repository generation.",
          "maxLength": 4096,
          "type": [
            "string",
            "null"
          ]
        },
        "exclude_paths": {
          "default": [],
          "description": "Exclude matching repository paths.",
          "items": {
            "maxLength": 4096,
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "expected_repository_id": {
          "default": null,
          "description": "Expected opaque repository identity from an earlier response.",
          "maxLength": 128,
          "type": [
            "string",
            "null"
          ]
        },
        "focus_paths": {
          "default": [],
          "description": "Boost matching paths without filtering other results.",
          "items": {
            "maxLength": 4096,
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "include_paths": {
          "default": [],
          "description": "Include only matching repository paths.",
          "items": {
            "maxLength": 4096,
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "max_response_tokens": {
          "default": null,
          "description": "Maximum tokens in the final serialized service response.",
          "format": "uint",
          "maximum": 32000,
          "minimum": 1,
          "type": "integer"
        },
        "max_results": {
          "default": 20,
          "description": "Maximum hits to return (default 20, maximum 100).",
          "format": "uint",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "max_tokens": {
          "default": 8000,
          "description": "Maximum source tokens across excerpts (default 8000, maximum 32000).",
          "format": "uint",
          "maximum": 32000,
          "minimum": 1,
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/SearchMode",
          "default": "auto",
          "description": "Candidate source to search (default `auto`)."
        },
        "prefer_structural": {
          "default": false,
          "description": "Prefer structural definitions when identifier channels find the same definition.",
          "type": "boolean"
        },
        "projection": {
          "$ref": "#/$defs/SearchMcpProjection",
          "default": "full",
          "description": "Response shape: `full` hits (default) or compact `grouped` matches."
        },
        "query": {
          "description": "Non-empty text, identifier, symbol, or Rust regular expression to find.",
          "maxLength": 65536,
          "minLength": 1,
          "type": "string"
        },
        "receipt_id": {
          "default": null,
          "description": "Suppress evidence already returned under this server-managed receipt.",
          "maxLength": 128,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    }
  }
]
