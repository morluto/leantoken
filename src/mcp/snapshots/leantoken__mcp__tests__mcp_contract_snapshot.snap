                    "maximum": 32000,
                    "minimum": 1,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "max_results": {
                    "default": null,
                    "description": "Maximum results (default 20; service-specific operations may use a lower bound).",
                    "format": "uint",
                    "maximum": 100,
                    "minimum": 1,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "max_tokens": {
                    "default": null,
                    "description": "Maximum source or diff tokens to return (default 8000, maximum 32000).",
                    "format": "uint",
                    "maximum": 32000,
                    "minimum": 1,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "path": {
                    "maxLength": 4096,
                    "minLength": 1,
                    "type": "string"
                  },
                  "revision": {
                    "description": "Trimmed, non-empty text accepted at a serialized service boundary.",
                    "maxLength": 4096,
                    "minLength": 1,
                    "type": "string"
                  },
                  "symbol": {
                    "$ref": "#/$defs/SymbolIdentity"
                  }
                },
                "required": [
                  "kind",
                  "path",
                  "symbol",
                  "revision"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Compare one parsed symbol across revisions, including added or removed endpoints.",
                "properties": {
                  "base_revision": {
                    "description": "Trimmed, non-empty text accepted at a serialized service boundary.",
                    "maxLength": 4096,
                    "minLength": 1,
                    "type": "string"
                  },
                  "head_revision": {
                    "description": "Trimmed, non-empty text accepted at a serialized service boundary.",
                    "maxLength": 4096,
                    "minLength": 1,
                    "type": "string"
                  },
                  "kind": {
                    "const": "diff_symbol",
                    "type": "string"
                  },
                  "max_response_tokens": {
                    "default": null,
                    "description": "Maximum tokens in the final serialized service response.",
                    "format": "uint",
                    "maximum": 32000,
                    "minimum": 1,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "max_results": {
                    "default": null,
                    "description": "Maximum results (default 20; service-specific operations may use a lower bound).",
                    "format": "uint",
                    "maximum": 100,
