    {
      "description": "Preferred over native jq or whole-file reads for bounded JSON inspection. Query, summarize, or compare live JSON without indexing it. Operations are query, numeric_summary, and diff_fields; collapsed, keys, and schema are query projections. Use JSON Pointer or JMESPath selectors; keys paginate in depth-then-pointer order with omission metadata. JSON requests do not accept consistency. JMESPath evaluates against the selected document root. Example: {\"operation\":{\"kind\":\"query\",\"path\":\"benchmarks/reports/graph-signal-ablation-v1.json\",\"projection\":\"keys\"}}. A zero numeric count means the selection has no numeric leaves, not that the file is malformed.",
      "inputSchema": {
        "$defs": {
          "JsonMcpOperation": {
            "oneOf": [
              {
                "additionalProperties": false,
                "description": "Select and project one JSON value.",
                "properties": {
                  "array_sample_size": {
                    "default": null,
                    "description": "Array elements sampled by collapsed projections (default 3, maximum 20).",
                    "format": "uint",
                    "maximum": 20,
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "cursor": {
                    "default": null,
                    "description": "Opaque cursor returned by an incomplete keys projection.",
                    "maxLength": 256,
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "depth": {
                    "default": null,
                    "description": "Maximum keys traversal depth relative to the selected root (root is zero).",
                    "format": "uint",
                    "maximum": 64,
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "kind": {
                    "const": "query",
                    "type": "string"
                  },
                  "max_items": {
                    "default": null,
                    "description": "Maximum structural items returned (default 1000, maximum 10000).",
                    "format": "uint",
                    "maximum": 10000,
                    "minimum": 1,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "max_response_tokens": {
                    "default": null,
                    "description": "Maximum tokens in the final serialized service response.",
                    "format": "uint",
                    "maximum": 32000,
                    "minimum": 1,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "max_tokens": {
                    "default": null,
                    "description": "Maximum tokens across selected/projected JSON (default 8000, maximum 32000).",
                    "format": "uint",
                    "maximum": 32000,
                    "minimum": 1,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "path": {
                    "maxLength": 4096,
                    "minLength": 1,
                    "type": "string"
                  },
                  "projection": {
                    "$ref": "#/$defs/JsonProjection",
                    "default": "value"
                  },
                  "selector": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/JsonMcpSelector"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "path"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Summarize numeric leaves below one JSON selection.",
                "properties": {
                  "array_sample_size": {
                    "default": null,
                    "description": "Array elements sampled by collapsed projections (default 3, maximum 20).",
                    "format": "uint",
                    "maximum": 20,
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "kind": {
                    "const": "numeric_summary",
                    "type": "string"
                  },
                  "max_items": {
                    "default": null,
                    "description": "Maximum structural items returned (default 1000, maximum 10000).",
                    "format": "uint",
                    "maximum": 10000,
                    "minimum": 1,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "max_response_tokens": {
                    "default": null,
                    "description": "Maximum tokens in the final serialized service response.",
                    "format": "uint",
                    "maximum": 32000,
                    "minimum": 1,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "max_tokens": {
                    "default": null,
                    "description": "Maximum tokens across selected/projected JSON (default 8000, maximum 32000).",
                    "format": "uint",
                    "maximum": 32000,
                    "minimum": 1,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "path": {
                    "maxLength": 4096,
                    "minLength": 1,
                    "type": "string"
                  },
                  "selector": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/JsonMcpSelector"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "path"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Compare selected fields between two JSON files.",
                "properties": {
                  "array_sample_size": {
                    "default": null,
                    "description": "Array elements sampled by collapsed projections (default 3, maximum 20).",
                    "format": "uint",
                    "maximum": 20,
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "base_path": {
                    "maxLength": 4096,
                    "minLength": 1,
                    "type": "string"
                  },
                  "head_path": {
                    "maxLength": 4096,
                    "minLength": 1,
                    "type": "string"
                  },
                  "kind": {
                    "const": "diff_fields",
                    "type": "string"
                  },
                  "max_items": {
                    "default": null,
                    "description": "Maximum structural items returned (default 1000, maximum 10000).",
                    "format": "uint",
                    "maximum": 10000,
                    "minimum": 1,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "max_response_tokens": {
                    "default": null,
                    "description": "Maximum tokens in the final serialized service response.",
                    "format": "uint",
                    "maximum": 32000,
                    "minimum": 1,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "max_tokens": {
                    "default": null,
                    "description": "Maximum tokens across selected/projected JSON (default 8000, maximum 32000).",
                    "format": "uint",
                    "maximum": 32000,
                    "minimum": 1,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "projection": {
                    "$ref": "#/$defs/JsonProjection",
                    "default": "value"
                  },
                  "selectors": {
                    "items": {
                      "$ref": "#/$defs/JsonMcpSelector"
                    },
                    "maxItems": 100,
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "kind",
                  "base_path",
                  "head_path",
                  "selectors"
                ],
                "type": "object"
              }
            ]
          },
          "JsonMcpSelector": {
            "oneOf": [
              {
                "additionalProperties": false,
                "description": "RFC 6901 JSON Pointer.",
                "properties": {
                  "kind": {
                    "const": "pointer",
                    "type": "string"
                  },
                  "pointer": {
                    "maxLength": 4096,
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "pointer"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Standard JMESPath expression.",
                "properties": {
                  "expression": {
                    "description": "Trimmed, non-empty text accepted at a serialized service boundary.",
                    "maxLength": 4096,
                    "minLength": 1,
                    "type": "string"
                  },
                  "kind": {
                    "const": "jmespath",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "expression"
                ],
                "type": "object"
              }
            ]
          },
          "JsonProjection": {
            "description": "Structural projection applied after JSON selection.",
            "oneOf": [
              {
                "const": "value",
                "description": "Preserve the selected JSON value.",
                "type": "string"
              },
              {
                "const": "collapsed",
                "description": "Replace arrays with count and bounded sample summaries.",
                "type": "string"
              },
              {
                "const": "keys",
                "description": "Return JSON Pointer-shaped key paths and value types only.",
                "type": "string"
              },
              {
                "const": "schema",
                "description": "Return an inferred structural schema without leaf values.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "expected_repository_id": {
            "default": null,
            "description": "Expected opaque repository identity from an earlier response.",
            "maxLength": 128,
            "type": [
              "string",
              "null"
            ]
          },
          "operation": {
            "$ref": "#/$defs/JsonMcpOperation",
            "description": "Structural JSON operation."
          },
          "repository_context": {
            "default": null,
            "description": "Optional name of an approved repository context.",
            "maxLength": 64,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "operation"
        ],
        "type": "object"
      },
      "name": "json"
    },
    {
      "description": "Preferred before native whole-file reads when the file is known but the relevant range is not. Inspect known files without reading whole source files. Returns definitions, imports, ranges, and parse coverage; set projection=signatures to keep only compact signatures. Next: pass a returned symbol or line range to read. Example: {\"paths\":[\"src/mcp/mod.rs\"]}.",
      "inputSchema": {
        "$defs": {
          "OutlineMcpProjection": {
            "description": "Response projection for structural outlines.",
            "oneOf": [
              {
                "const": "full",
                "description": "Preserve symbols, imports, and byte offsets.",
                "type": "string"
              },
              {
                "const": "signatures",
                "description": "Return symbol signatures and line ranges without imports or byte offsets.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "consistency": {
            "default": "indexed_generation",
            "description": "Use `reconcile_working_tree` after edits; otherwise `indexed_generation`.",
            "enum": [
              "indexed_generation",
              "reconcile_working_tree"
            ],
            "type": "string"
          },
          "cursor": {
            "default": null,
            "description": "Opaque cursor from a result-limited outline response.",
            "maxLength": 256,
            "type": [
              "string",
              "null"
            ]
          },
          "expected_repository_id": {
            "default": null,
            "description": "Expected opaque repository identity from an earlier response.",
            "maxLength": 128,
            "type": [
              "string",
              "null"
            ]
          },
          "max_response_tokens": {
            "default": null,
            "description": "Maximum tokens in the final serialized service response.",
            "format": "uint",
            "maximum": 32000,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "max_results": {
            "default": null,
            "description": "Maximum definitions and imports to return (default 20, maximum 100).",
            "format": "uint",
            "maximum": 100,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "max_tokens": {
            "default": null,
            "description": "Maximum signature and import tokens (default 8000, maximum 32000).",
            "format": "uint",
            "maximum": 32000,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "paths": {
            "description": "One to 256 repository-relative source files to outline.",
            "items": {
              "maxLength": 4096,
              "type": "string"
            },
            "maxItems": 256,
            "minItems": 1,
            "type": "array"
          },
          "projection": {
            "$ref": "#/$defs/OutlineMcpProjection",
            "default": "full",
            "description": "Response shape: `full` definitions (default) or compact `signatures`."
          },
          "receipt_id": {
            "default": null,
            "description": "Suppress evidence already returned under this server-managed receipt.",
            "maxLength": 128,
            "type": [
              "string",
              "null"
            ]
          },
          "repository_context": {
            "default": null,
            "description": "Optional name of an approved repository context.",
            "maxLength": 64,
            "type": [
              "string",
              "null"
            ]
          },
          "symbol_kind": {
            "default": null,
            "description": "Keep definitions of this exact syntax kind.",
            "maxLength": 4096,
            "type": [
              "string",
              "null"
            ]
          },
          "symbol_name": {
            "default": null,
            "description": "Keep definitions whose names contain this value.",
            "maxLength": 4096,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "paths"
        ],
        "type": "object"
      },
      "name": "outline"
    },
    {
      "description": "Preferred over native Read, cat, head, or sed for repository source. Read an exact symbol, Markdown heading, line range, or continuation. Keep path separate from target; use a symbol or line range from search or outline. Set delta=true or pass expected_hash to suppress unchanged content; truncated reads return a continuation cursor and source-budget guidance. Example: {\"path\":\"README.md\",\"target\":{\"kind\":\"heading\",\"name\":\"Installation\"}}.",
      "inputSchema": {
        "$defs": {
          "ReadMcpTarget": {
            "oneOf": [
              {
                "additionalProperties": false,
                "description": "Read one indexed symbol definition.",
                "properties": {
                  "identity": {
                    "$ref": "#/$defs/SymbolIdentity",
                    "description": "Structured indexed symbol identity."
                  },
                  "kind": {
                    "const": "symbol",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "identity"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Read one indexed Markdown or LaTeX section by exact title or outline signature.",
                "properties": {
                  "kind": {
                    "const": "heading",
                    "type": "string"
                  },
                  "name": {
                    "description": "Exact title or outline signature such as `## Performance` or `\\section{Method}`.",
                    "maxLength": 4096,
                    "minLength": 1,
                    "type": "string"
                  },
                  "occurrence": {
                    "default": 1,
                    "description": "One-based occurrence when the heading text is duplicated.",
                    "format": "uint",
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "kind",
                  "name"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Read one inclusive one-based line range.",
                "properties": {
                  "end": {
                    "description": "Last one-based line; must be at least `start`.",
                    "format": "uint",
                    "minimum": 1,
                    "type": "integer"
                  },
                  "kind": {
                    "const": "lines",
                    "type": "string"
                  },
                  "start": {
                    "description": "First one-based line.",
                    "format": "uint",
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "kind",
                  "start",
                  "end"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Continue a truncated read without losing a partial final line.",
                "properties": {
                  "cursor": {
                    "description": "Opaque cursor from the preceding truncated response.",
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string"
                  },
                  "kind": {
                    "const": "continuation",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "cursor"
                ],
                "type": "object"
              }
            ]
          },
          "ReadPolicy": {
            "description": "I/O and verification policy for a live read.\n\n`Bounded` (default) stops reading after the requested page is satisfied,\nreports `index_state: unknown`, and emits a prefix-stable continuation. It\ncannot prove that an unread suffix is unchanged. `Full` hashes the complete\nlive file, reports current/stale with live and indexed hashes, and emits a\ncontent-snapshot continuation. It is required for delta requests.",
            "oneOf": [
              {
                "const": "bounded",
                "description": "Stop after the requested page; no full-file hash or index staleness.",
                "type": "string"
              },
              {
                "const": "full",
                "description": "Hash the complete live file and report index verification metadata.",
                "type": "string"
              }
            ]
          },
          "SymbolIdentity": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              "parent": {
                "maxLength": 4096,
                "minLength": 1,
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "consistency": {
            "default": "indexed_generation",
            "description": "Use `reconcile_working_tree` after edits; otherwise `indexed_generation`.",
            "enum": [
              "indexed_generation",
              "reconcile_working_tree"
            ],
            "type": "string"
          },
          "delta": {
            "default": false,
            "description": "Record this target and prefer a cheaper follow-up. Without `expected_hash`,\nselect the latest compatible base for this exact target.",
            "type": "boolean"
          },
          "expected_hash": {
            "default": null,
            "description": "Hash from the same prior target; matching content returns `not_modified`.",
            "maxLength": 128,
            "type": [
              "string",
              "null"
            ]
          },
          "expected_repository_id": {
            "default": null,
            "description": "Expected opaque repository identity from an earlier response.",
            "maxLength": 128,
            "type": [
              "string",
              "null"
            ]
          },
          "max_response_tokens": {
            "default": null,
            "description": "Maximum tokens in the final serialized service response.",
            "format": "uint",
            "maximum": 32000,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "max_tokens": {
            "default": null,
            "description": "Maximum source tokens to return (default 8000, maximum 32000).",
            "format": "uint",
            "maximum": 32000,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "path": {
            "description": "Repository-relative UTF-8 source file.",
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "policy": {
            "$ref": "#/$defs/ReadPolicy",
            "default": "bounded",
            "description": "I/O and verification policy. `bounded` (default) stops after the\nrequested page and reports `index_state: unknown`. `full` hashes the\ncomplete live file, reports current/stale with indexed hashes, and is\nrequired for `delta: true`."
          },
          "receipt_id": {
            "default": null,
            "description": "Suppress evidence already returned under this server-managed receipt.",
            "maxLength": 128,
            "type": [
              "string",
              "null"
            ]
          },
          "repository_context": {
            "default": null,
            "description": "Optional name of an approved repository context.",
            "maxLength": 64,
            "type": [
              "string",
              "null"
            ]
          },
          "target": {
            "$ref": "#/$defs/ReadMcpTarget",
            "description": "Exact symbol, document heading, line range, or continuation to read."
          }
        },
        "required": [
          "path",
          "target"
        ],
        "type": "object"
      },
      "name": "read"
    },
    {
      "description": "Explicitly carry only exactly unchanged evidence from a stale server-managed receipt into the current committed generation. Requires the same repository/cache/scope identity and exact path, line coordinates, and content hash; never guesses line shifts, renames, symbol relocation, overlap, near-duplicates, or fuzzy matches. Returns complete carried/changed/missing/unmapped counts, bounded source-free samples, and a digest. Example: {\"receipt_id\":\"r...\",\"consistency\":\"reconcile_working_tree\"}.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "consistency": {
            "default": "indexed_generation",
            "description": "Use `reconcile_working_tree` after edits; otherwise `indexed_generation`.",
            "enum": [
              "indexed_generation",
              "reconcile_working_tree"
            ],
            "type": "string"
          },
          "expected_repository_id": {
            "default": null,
            "description": "Expected opaque repository identity from an earlier response.",
            "maxLength": 128,
            "type": [
              "string",
              "null"
            ]
          },
          "max_response_tokens": {
            "default": null,
            "description": "Maximum tokens in the final serialized service response.",
            "format": "uint",
            "maximum": 32000,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "max_samples_per_outcome": {
            "default": null,
            "description": "Maximum source-free examples per outcome; complete counts and digest are always returned.",
            "format": "uint",
            "maximum": 16,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "receipt_id": {
            "description": "Opaque server-managed receipt from an earlier repository generation.",
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "repository_context": {
            "default": null,
            "description": "Optional name of an approved repository context.",
            "maxLength": 64,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "receipt_id"
        ],
        "type": "object"
      },
      "name": "receipt_rebase"
    },
    {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Report repository-local response accounting, request classifications, expected-hash suppression, service failures, and unobserved task outcomes. Returns an opaque snapshot for a later bounded delta; savings are retrieval accounting, not task-success claims. Example: {}.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "repository_context": {
            "default": null,
            "description": "Optional name of an approved repository context.",
            "maxLength": 64,
            "type": [
              "string",
              "null"
            ]
          },
          "snapshot": {
            "default": null,
            "description": "Opaque snapshot from an earlier savings response; returns aggregate deltas.",
            "maxLength": 32768,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "name": "savings"
    },
    {
      "description": "Preferred over native grep or rg for repository source search. Search indexed source with operation.kind auto, symbol, reference, identifier, text, or regex. Symbol and structural modes are ranked; projection=compact returns source-free coordinates and symbol identity. all_occurrences=true requires text or regex mode; projection=occurrences also requires all_occurrences=true; coordinates_only omits excerpts. query_receipt records or reuses complete coverage and fails closed when indexed files change. Counts are exact and bounded; enclosing_symbol and ranges identify the next read target. max_results uses the configured cap and rejects larger requests with that limit. Example: {\"operation\":{\"kind\":\"symbol\",\"query\":\"InternalFailure\",\"projection\":\"compact\"}}; exhaustive: {\"operation\":{\"kind\":\"text\",\"query\":\"InternalFailure\",\"all_occurrences\":true,\"projection\":\"occurrences\"}}.",
      "inputSchema": {
        "$defs": {
          "QueryReceiptAction": {
            "description": "Explicit lifecycle action for one exhaustive-query coverage receipt.",
            "oneOf": [
              {
                "additionalProperties": false,
                "description": "Record a receipt only when the exhaustive result is returned completely.",
                "properties": {
                  "kind": {
                    "const": "record",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Reuse a prior complete receipt instead of repeating the exhaustive scan.",
                "properties": {
                  "kind": {
                    "const": "reuse",
                    "type": "string"
                  },
                  "receipt_id": {
                    "description": "Opaque server-managed query receipt.",
                    "maxLength": 128,
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "receipt_id"
                ],
                "type": "object"
              }
            ]
          },
          "SearchMcpOperation": {
            "oneOf": [
              {
                "additionalProperties": false,
                "description": "Search options are structurally generated here; runtime validation additionally enforces cross-field rules: all_occurrences requires text or regex mode, occurrences projection requires all_occurrences=true, coordinates_only requires all_occurrences=true with auto or occurrences projection, and query_receipt requires occurrence projection.",
                "properties": {
                  "all_occurrences": {
                    "default": false,
                    "type": "boolean"
                  },
                  "case_sensitive": {
                    "default": false,
                    "type": "boolean"
                  },
                  "consistency": {
                    "default": "indexed_generation",
                    "description": "Use `reconcile_working_tree` after edits; otherwise use the indexed generation.",
                    "enum": [
                      "indexed_generation",
                      "reconcile_working_tree"
                    ],
                    "type": "string"
                  },
                  "context_lines": {
                    "default": null,
                    "description": "The server's configured context_lines value applies when this field is omitted.",
                    "format": "uint",
                    "maximum": 20,
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "coordinates_only": {
                    "default": false,
                    "type": "boolean"
                  },
                  "cursor": {
                    "default": null,
                    "maxLength": 4096,
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "exclude_paths": {
                    "default": [],
                    "items": {
                      "maxLength": 4096,
                      "type": "string"
                    },
                    "maxItems": 256,
                    "type": "array"
                  },
                  "focus_paths": {
                    "default": [],
                    "items": {
                      "maxLength": 4096,
                      "type": "string"
                    },
                    "maxItems": 256,
                    "type": "array"
                  },
                  "include_paths": {
                    "default": [],
                    "items": {
                      "maxLength": 4096,
                      "type": "string"
                    },
                    "maxItems": 256,
                    "type": "array"
                  },
                  "kind": {
                    "const": "auto",
                    "type": "string"
                  },
                  "max_response_tokens": {
                    "default": null,
                    "format": "uint",
                    "maximum": 32000,
                    "minimum": 1,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "max_results": {
                    "default": null,
                    "description": "The server's configured max_results cap may be lower than the protocol ceiling; omitted values use config.default_results.",
                    "format": "uint",
                    "maximum": 100,
                    "minimum": 1,
                    "type": [
