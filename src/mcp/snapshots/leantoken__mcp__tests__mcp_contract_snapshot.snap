  "tools": [
    {
      "description": "DEFAULT FIRST CALL for broad repository coding, debugging, review, or architecture triage. Build a bounded, ranked evidence bundle for a broad coding, debugging, review, or architecture task. Returns fragments, coverage, omissions, and an optional receipt; plan_only previews candidates without source or receipt mutation. Use strict scopes and required evidence when coverage must be explicit, response_profile=compact for the smallest fail-loud result, and known_hashes or receipt_id for follow-ups. Example: {\"task\":\"Audit MCP tool discovery\"}.",
      "inputSchema": {
        "$defs": {
          "ContextRequiredEvidence": {
            "additionalProperties": false,
            "description": "One path-scoped evidence requirement for `leantoken.context`.",
            "properties": {
              "minimum_query_matches": {
                "default": 1,
                "description": "Minimum number of distinct queries that selected evidence must match.",
                "format": "uint",
                "maximum": 16,
                "minimum": 1,
                "type": "integer"
              },
              "path": {
                "description": "Repository-relative path pattern whose evidence must be represented.",
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              "queries": {
                "description": "Alternative literal queries; distinct matches contribute to the minimum.",
                "items": {
                  "maxLength": 4096,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 16,
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "path",
              "queries"
            ],
            "type": "object"
          },
          "ContextResponseProfile": {
            "description": "Presentation depth for a context response.\n\nProfiles never change candidate generation, ranking, selected fragment\nmembership or order, source-token budgets, hard constraints, or receipt\nsuppression.",
