              {
                "const": "compact",
                "description": "Preserve fail-loud coverage and routing while omitting optional detail.",
                "type": "string"
              },
              {
                "const": "balanced",
                "description": "Preserve the historical default response shape and diagnostics.",
                "type": "string"
              },
              {
                "const": "explain",
                "description": "Include the complete bounded omission and diff diagnostics.",
                "type": "string"
              }
            ]
          },
          "ContextWorkflow": {
            "description": "Requested or resolved evidence workflow for context retrieval.",
