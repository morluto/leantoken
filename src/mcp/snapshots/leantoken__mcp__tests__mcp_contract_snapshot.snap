                    ]
                  }
                },
                "required": [
                  "kind",
                  "query"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Search options are structurally generated here; runtime validation additionally enforces cross-field rules: all_occurrences requires text or regex mode, occurrences projection requires all_occurrences=true, coordinates_only requires all_occurrences=true with auto or occurrences projection, and query_receipt requires occurrence projection.",
                "properties": {
                  "all_occurrences": {
                    "default": false,
                    "type": "boolean"
                  },
                  "case_sensitive": {
                    "default": false,
                    "type": "boolean"
                  },
                  "consistency": {
                    "default": "indexed_generation",
                    "description": "Use `reconcile_working_tree` after edits; otherwise use the indexed generation.",
                    "enum": [
                      "indexed_generation",
                      "reconcile_working_tree"
                    ],
                    "type": "string"
                  },
                  "context_lines": {
                    "default": null,
                    "description": "The server's configured context_lines value applies when this field is omitted.",
                    "format": "uint",
                    "maximum": 20,
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "coordinates_only": {
                    "default": false,
                    "type": "boolean"
                  },
                  "cursor": {
                    "default": null,
                    "maxLength": 4096,
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "exclude_paths": {
                    "default": [],
                    "items": {
                      "maxLength": 4096,
                      "type": "string"
                    },
                    "maxItems": 256,
                    "type": "array"
                  },
                  "focus_paths": {
                    "default": [],
                    "items": {
                      "maxLength": 4096,
                      "type": "string"
                    },
                    "maxItems": 256,
                    "type": "array"
                  },
                  "include_paths": {
                    "default": [],
                    "items": {
                      "maxLength": 4096,
                      "type": "string"
                    },
                    "maxItems": 256,
                    "type": "array"
                  },
                  "kind": {
                    "const": "reference",
                    "type": "string"
                  },
                  "max_response_tokens": {
                    "default": null,
                    "format": "uint",
                    "maximum": 32000,
                    "minimum": 1,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "max_results": {
                    "default": null,
                    "description": "The server's configured max_results cap may be lower than the protocol ceiling; omitted values use config.default_results.",
                    "format": "uint",
                    "maximum": 100,
                    "minimum": 1,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "max_tokens": {
                    "default": null,
                    "description": "The server's configured default_read_tokens value applies when this field is omitted.",
                    "format": "uint",
                    "maximum": 32000,
                    "minimum": 1,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "prefer_structural": {
                    "default": false,
                    "type": "boolean"
                  },
                  "projection": {
                    "$ref": "#/$defs/SearchMcpProjection",
                    "default": "auto"
                  },
                  "query": {
                    "description": "Non-empty search query; leading and trailing whitespace is significant.",
                    "maxLength": 65536,
                    "minLength": 1,
                    "type": "string"
                  },
                  "query_receipt": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/QueryReceiptAction"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "receipt_id": {
                    "default": null,
                    "maxLength": 128,
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "query"
                ],
                "type": "object"
              }
            ]
          },
          "SearchMcpProjection": {
            "enum": [
              "auto",
              "full",
              "compact",
              "grouped",
              "occurrences"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
